[TEMPLATE]
PORT=3002
# Primary connection string (compose sets MONGO_URI; MONGODB_URI is accepted as an alias)
MONGO_URI=mongodb://localhost:27017/chat_db
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_PUBLIC_KEY=
CORS_ORIGINS=http://localhost:5173
# Authoritative block lookup (POST /users/blocks/check) - internal only
USER_SERVICE_URL=http://localhost:3003
CONTENT_SERVICE_URL=http://localhost:3001
# Chat attachments must point inside this bucket (same allowlist as posts)
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=socialpulse-media
NODE_ENV=development
