# Copy to .env, then run: sh scripts/gen-keys.sh
CORS_ORIGINS=http://localhost:5173
MINIO_PUBLIC_URL=http://localhost:9000
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Host port the api-gateway is published on. If you change it, set PUBLIC_API_URL to the
# browser-reachable equivalent (it is baked into the frontend image at build time) and rebuild
# the frontend:  docker compose up -d --build frontend
GATEWAY_PORT=8080
PUBLIC_API_URL=http://localhost:8080

# Public origin of the web UI. Verification / password-reset links in emails point here.
APP_ORIGIN=http://localhost:5173

# Transactional email (email verification + password reset). Leave SMTP_HOST blank to run in
# console mode: nothing is sent, and the service logs that a message was skipped (never the token).
# Any SMTP provider works (Mailtrap, Mailpit, MailHog, Postmark, SendGrid, SES SMTP, Gmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=SocialPulse <no-reply@socialpulse.local>

# ---- Google sign-in (OAuth 2.0 authorization code + PKCE) ----
# Leave blank to hide/disable the "Continue with Google" button (the API reports enabled:false).
# Create a "Web application" OAuth client in Google Cloud Console and register the redirect URI
# EXACTLY as configured below - OAuth fails with redirect_uri_mismatch on any difference.
#
# GOOGLE_REDIRECT_URI must point at this project's auth routing. Both of these work and are
# equivalent (the gateway aliases /api/auth to /auth):
#   http://localhost:${GATEWAY_PORT}/auth/google/callback
#   http://localhost:${GATEWAY_PORT}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a separate web client id, if GOOGLE_CLIENT_ID is used for another platform.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# The OAuth state cookie can only be marked Secure over real HTTPS. Leave false on localhost,
# set true once the app is served over TLS.
COOKIE_SECURE=false

# LOCAL DEVELOPMENT ONLY. When true (and NODE_ENV != production) register / forgot-password
# responses echo the emailed link as `devLink`, so you can complete verification and reset
# without an inbox. Never enable in production. Defaults to false.
AUTH_DEV_RETURN_LINKS=false

# Token lifetimes.
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Gateway rate limits (per minute, in-memory and therefore per gateway instance).
# The auth limit is deliberately strict; raise it while running scripts/integration-fixes.mjs.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
