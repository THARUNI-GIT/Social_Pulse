PORT=3003
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# PEM with \n escapes; generate with scripts/gen-keys.sh at repo root (Step 7)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=socialpulse
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Public web origin used to build verification / reset links (never taken from the request Host)
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080

# Transactional email. Leave SMTP_HOST blank to run in console mode: nothing is sent and the
# service logs that the message was skipped (never the token).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=SocialPulse <no-reply@socialpulse.local>
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
# Local development only: return devLink in register/forgot-password responses (NODE_ENV != production)
AUTH_DEV_RETURN_LINKS=false

# Google sign-in (OAuth 2.0 authorization code + PKCE). Leave blank to disable the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# The OAuth state cookie can only be Secure over real HTTPS; keep false on localhost.
COOKIE_SECURE=false

NODE_ENV=development
